export function renderAboutYouDocument(token: string): string {
  const script = ABOUT_YOU_JS.replace('__ABOUT_YOU_TOKEN__', JSON.stringify(token).replace(/</g, '\\u003c'));
  return '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">' +
    '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; script-src \'unsafe-inline\'; style-src \'unsafe-inline\'; img-src data: https:; connect-src \'none\'; base-uri \'none\'; form-action \'none\'">' +
    '<title>关于你</title><style>' + ABOUT_YOU_CSS + '</style></head><body>' + ABOUT_YOU_BODY +
    '<script>' + script + '</script></body></html>';
}

export function buildAboutYouUpdate(modelJson: string, topInset: number, bottomInset: number): string {
  return 'window.AboutYou && window.AboutYou.receive(' + JSON.stringify(modelJson) +
    ', {top:' + Math.max(0, topInset).toString() + ',bottom:' + Math.max(0, bottomInset).toString() + '});';
}

export function buildAboutYouDocumentUrl(token: string): string {
  return 'data:text/html;charset=utf-8,' + encodeURIComponent(renderAboutYouDocument(token));
}
