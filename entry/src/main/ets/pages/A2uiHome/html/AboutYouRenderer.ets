function send(type,data){var payload=Object.assign({type:type,token:token},data||{});if(type==='correct')payload.overviewRevision=model?model.overviewRevision:0;if(window.AboutYouHost&&typeof window.AboutYouHost.postAction==='function')window.AboutYouHost.postAction(JSON.stringify(payload));}
