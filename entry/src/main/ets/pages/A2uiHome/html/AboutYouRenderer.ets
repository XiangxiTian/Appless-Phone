const ABOUT_YOU_BODY: string = `
<main class="page" id="page"><header class="topbar"><button class="icon" id="back" aria-label="返回"></button><h1>关于你</h1><button class="icon" id="refresh" aria-label="重新整理概览"></button></header>
<section class="card profile"><div class="identity"><div class="avatar" id="avatar"></div><div><p class="eyebrow">一点一滴，慢慢了解</p><h2 class="name" id="name"></h2></div></div><p class="summary" id="summary"></p><div class="tags" id="tags"></div></section>
<div id="overview-status" role="status" aria-live="polite"></div><div id="sections"></div>
<p class="section-label">让这份了解更贴近你</p><section class="card" id="update-card"><h2 class="update-title">有什么需要更新？</h2><p class="muted">新的兴趣、习惯，或是我们理解有偏差的地方。</p><div id="correction-context" class="context" hidden><span id="context-text"></span><button id="context-clear" aria-label="取消章节选择">×</button></div><textarea id="correction" class="field update-field" aria-label="修改意见" maxlength="8000" placeholder="告诉我，你想补充或修改什么…"></textarea><div class="update-actions"><button class="primary" id="correct">更新了解</button></div><div id="update-error" class="error" role="status" hidden></div><p id="stale-note" class="notice" hidden>有新的记忆了，重新整理后就可以修改。</p>
<div class="divider"></div><button class="social-entry" id="social-open"><span class="section-icon" id="social-icon"></span><span class="entry-copy"><strong>从公开账号补充</strong><span class="muted" id="social-description">找到你的公开分享，再由你决定是否采纳</span></span><span id="social-arrow"></span></button><div class="accounts" id="accounts"></div>
<div class="social-flow" id="social-flow" hidden><div id="search-controls"><label for="username">账号名或姓名</label><div class="search-row"><input id="username" class="field" maxlength="160" autocomplete="off" placeholder="输入账号名或姓名"><button class="primary" id="search">查找</button></div><div class="mode-row"><button id="mode-fuzzy" class="active" aria-pressed="true">综合查找</button><button id="mode-exact" aria-pressed="false">精确账号名</button></div></div><div class="progress" id="progress" role="status" hidden><span class="spinner"></span><span id="progress-text"></span></div><div id="social-error" class="error" role="status" hidden></div><button class="plain" id="retry" hidden>重新尝试</button><div id="confirmation" hidden><p class="muted">勾选属于你的账号，我们会阅读这些账号的公开内容。</p><div id="candidates"></div><label class="confirm-name" for="confirmed-name">希望如何称呼你</label><input id="confirmed-name" class="field" maxlength="160"><button id="confirm" class="primary confirm-action">确认账号，生成补充资料</button></div><button id="resume-draft" class="secondary confirm-action" hidden>继续查看待确认资料</button></div></section><p class="page-footer">你的了解，由你来完善</p></main>
<div class="modal-backdrop" id="review-overlay" hidden><section class="modal" role="dialog" aria-modal="true" aria-labelledby="review-title"><header class="modal-header"><div><h2 id="review-title">确认这份补充资料</h2><p class="muted">先看看是否准确，也可以直接修改</p></div><button id="review-close" class="icon" aria-label="暂时收起，保留草稿"></button></header><div class="modal-body"><div class="markdown" id="markdown"></div><textarea class="field edit-markdown" id="markdown-editor" aria-label="编辑补充资料" maxlength="60000" hidden></textarea></div><footer class="modal-footer"><div class="review-tools"><span class="muted" id="review-hint">确认后才会更新长期记忆</span><button class="plain" id="edit-toggle">修改内容</button></div><p class="status-note" id="import-error" role="status" hidden></p><div class="footer-actions"><button class="secondary" id="discard">丢弃结果</button><button class="primary" id="import">导入长期记忆</button></div></footer></section></div>
`;

